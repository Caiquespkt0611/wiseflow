generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receitas           Receita[]
  receitasVariaveis  ReceitaVariavel[]
  despesasFixas      DespesaFixa[]
  despesasVariaveis  DespesaVariavel[]
  contasBancarias    ContaBancaria[]
  importacoesFatura  ImportacaoFatura[]

  @@map("users")
}

model ContaBancaria {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome      String
  saldo     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("contas_bancarias")
}

model Receita {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  descricao   String
  tipo        String
  valor       Float
  data        DateTime
  responsavel String
  recorrente    Boolean   @default(false)
  parcelada     Boolean   @default(false)
  mesesTotal    Int?
  excecoes      String[]  @default([])
  ativa         Boolean   @default(true)
  confirmadaAte DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@map("receitas")
}

model DespesaFixa {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  descricao             String
  valor                 Float
  responsavel           String
  categoria             String    @default("Outros")
  recorrente            Boolean   @default(true)
  ativa                 Boolean   @default(true)
  dataInicio            DateTime
  dataProximoVencimento DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("despesas_fixas")
}

model ReceitaVariavel {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  descricao     String
  fonte         String
  categoria     String    @default("Outros")
  valorTotal    Float
  parcelaAtual  Int
  parcelasTotal Int
  valorParcela  Float
  responsavel   String
  dataInicio    DateTime
  confirmadaAte DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@map("receitas_variaveis")
}

model DespesaVariavel {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  descricao     String
  cartao        String
  categoria     String    @default("Outros")
  valorTotal    Float
  parcelaAtual  Int
  parcelasTotal Int
  valorParcela  Float
  responsavel   String
  dataInicio    DateTime
  confirmadaAte DateTime?

  // Origem do registro: "manual" (digitado ou por voz) ou "fatura" (veio de uma importação).
  // conferidaEm marca a despesa que a fatura confirmou, sem criar nada novo.
  origem       String            @default("manual")
  importacaoId String?
  importacao   ImportacaoFatura? @relation(fields: [importacaoId], references: [id], onDelete: SetNull)
  conferidaEm  DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([importacaoId])
  @@map("despesas_variaveis")
}

/// Um lote de importação de fatura. Guarda o que foi criado e o que foi apenas
/// marcado como conferido, para que a importação inteira possa ser desfeita.
model ImportacaoFatura {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cartao         String
  mesRef         String
  totalInformado Float?
  totalLido      Float
  itensLidos     Int
  criadas        Int
  conferidas     String[] @default([])
  arquivos       String[] @default([])
  createdAt      DateTime @default(now())

  despesas DespesaVariavel[]

  @@index([userId])
  @@index([userId, cartao, mesRef])
  @@map("importacoes_fatura")
}
