generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Quanto o plano de quitação nunca deixa a conta ficar abaixo. Nulo = usa a sugestão.
  reservaMinima Float?
  // Quanto o plano supõe de cartão por mês quando o lançado for menor (compra
  // futura ainda não existe na projeção). Nulo = usa a sugestão.
  cartaoMensal  Float?

  receitas           Receita[]
  receitasVariaveis  ReceitaVariavel[]
  despesasFixas      DespesaFixa[]
  despesasVariaveis  DespesaVariavel[]
  contasBancarias    ContaBancaria[]
  importacoesFatura  ImportacaoFatura[]
  emprestimos        Emprestimo[]

  @@map("users")
}

model ContaBancaria {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome      String
  saldo     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("contas_bancarias")
}

model Receita {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  descricao   String
  tipo        String
  valor       Float
  data        DateTime
  responsavel String
  recorrente    Boolean   @default(false)
  parcelada     Boolean   @default(false)
  mesesTotal    Int?
  excecoes      String[]  @default([])
  ativa         Boolean   @default(true)
  confirmadaAte DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@map("receitas")
}

model DespesaFixa {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  descricao             String
  valor                 Float
  responsavel           String
  categoria             String    @default("Outros")
  recorrente            Boolean   @default(true)
  ativa                 Boolean   @default(true)
  dataInicio            DateTime
  dataProximoVencimento DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("despesas_fixas")
}

model ReceitaVariavel {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  descricao     String
  fonte         String
  categoria     String    @default("Outros")
  valorTotal    Float
  parcelaAtual  Int
  parcelasTotal Int
  valorParcela  Float
  responsavel   String
  dataInicio    DateTime
  confirmadaAte DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@map("receitas_variaveis")
}

model DespesaVariavel {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  descricao     String
  cartao        String
  categoria     String    @default("Outros")
  valorTotal    Float
  parcelaAtual  Int
  parcelasTotal Int
  valorParcela  Float
  responsavel   String
  dataInicio    DateTime
  confirmadaAte DateTime?

  // Origem do registro: "manual" (digitado ou por voz) ou "fatura" (veio de uma importação).
  // conferidaEm marca a despesa que a fatura confirmou, sem criar nada novo.
  origem       String            @default("manual")
  importacaoId String?
  importacao   ImportacaoFatura? @relation(fields: [importacaoId], references: [id], onDelete: SetNull)
  conferidaEm  DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([importacaoId])
  @@map("despesas_variaveis")
}

/// Um lote de importação de fatura. Guarda o que foi criado e o que foi apenas
/// marcado como conferido, para que a importação inteira possa ser desfeita.
model ImportacaoFatura {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cartao         String
  mesRef         String
  totalInformado Float?
  totalLido      Float
  itensLidos     Int
  criadas        Int
  conferidas     String[] @default([])
  arquivos       String[] @default([])
  createdAt      DateTime @default(now())

  despesas DespesaVariavel[]

  @@index([userId])
  @@index([userId, cartao, mesRef])
  @@map("importacoes_fatura")
}

/// Empréstimo com os dados do contrato. Não é despesa fixa: tem fim, tem taxa e
/// pode ser antecipado, e é isso que o plano de quitação precisa saber.
/// A parcela k vence em primeiroVencimento + (k-1) meses (ou anos, se anual).
model Emprestimo {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  apelido    String // como o casal chama: "Silicone", "Cruzeiro"
  banco      String
  contrato   String?
  modalidade String

  // "conta": sai da conta e entra na projeção.
  // "folha": desconta no salário, que já é lançado líquido. Fica fora da
  //          projeção; quitado, o salário volta a ter o valor da parcela.
  // "fgts":  sai do FGTS (saque-aniversário). Não mexe no caixa.
  pagamento     String
  periodicidade String @default("mensal") // "mensal" | "anual"

  valorContratado Float
  taxaMensal      Float // juros do contrato, % ao mês. É a taxa do desconto na antecipação
  cetMensal       Float?
  taxaEstimada    Boolean @default(false) // calculada pela parcela, sem o contrato em mãos

  parcelasTotal      Int
  valorParcela       Float
  valoresParcelas    Float[]  @default([]) // quando cada parcela tem um valor (FGTS)
  primeiroVencimento DateTime

  proximaParcela      Int       @default(1) // a próxima que ainda não foi paga
  parcelasAntecipadas Int       @default(0) // últimas parcelas já quitadas por antecipação
  quitadoEm           DateTime?
  observacao          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("emprestimos")
}
